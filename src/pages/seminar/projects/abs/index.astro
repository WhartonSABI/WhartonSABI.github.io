    .visual-grid.two-up { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .visual-block { min-width: 0; }
    .visual-title { margin-bottom: 1rem; }
    .visual-title h3 { font-size: 1.15rem; line-height: 1.25; font-weight: 700; letter-spacing: -.015em; }
    .visual-title p { margin-top: .3rem; color: var(--abs-muted); font-size: .82rem; line-height: 1.45; }
    .chart-wrap { position: relative; min-width: 0; }
    .chart-wrap svg { display: block; overflow: visible; }
    .chart-tooltip { display: none; position: absolute; z-index: 5; width: max-content; max-width: 240px; padding: .55rem .65rem; background: var(--abs-blue); color: #fff; border-radius: .45rem; box-shadow: 0 8px 24px rgba(1,31,91,.2); font-size: .72rem; line-height: 1.45; pointer-events: none; }
    .chart-tooltip span { color: #D1DAEC; }
    .svg-label { fill: var(--abs-muted); font-size: 12px; }
    .svg-value { fill: var(--abs-blue); font-size: 12px; font-weight: 700; }
