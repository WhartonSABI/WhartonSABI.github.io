    .section-heading { display: grid; grid-template-columns: 3.2rem 1fr; gap: .9rem; align-items: start; margin-bottom: 2rem; }
    .section-number { color: var(--abs-red); font-size: .78rem; font-weight: 700; letter-spacing: .09em; }
