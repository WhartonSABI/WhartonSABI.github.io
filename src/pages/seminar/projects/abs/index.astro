    .kpi-card small { display: block; margin-top: .55rem; color: var(--abs-muted); font-size: .73rem; line-height: 1.35; }
    .league-answer { display: grid; grid-template-columns: minmax(190px, .6fr) 2fr; gap: 1.4rem; align-items: center; margin-top: 1rem; padding: 1.2rem 0; border-block: 1px solid var(--abs-border); }
